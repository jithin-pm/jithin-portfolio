  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0 user-scalable=no" />
  <title>Yellowtooths</title>
  <meta name="description" content="Yellowtooths" />
  <link rel="icon" href="/favicon-02.svg" sizes="48x48" />
  <link rel="icon" href="/favicon-02.svg" sizes="any" type="image/svg+xml" />
  <link
    rel="apple-touch-icon"
    href="/favicon-02.svg"
    sizes="180x180" />
  <link rel="mask-icon" href="/favicon-02.svg" color="#000000" />
  <meta id="theme-color" name="theme-color" content="#000000" />

  <!-- iOS Splash Screens -->
  <link
    rel="apple-touch-startup-image"
    href="/favicon-02.svg"
    media="(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2)" />
  <link
